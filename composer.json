{
    "name": "datalogix/laravel-error-pages",
    "description": "Renders custom HTTP error pages (404, 403, 500, ...) with translated copy, using TALLKit components when available.",
    "keywords": [
        "laravel",
        "error-pages",
        "exceptions",
        "tallkit",
        "http-errors"
    ],
    "homepage": "https://github.com/datalogix/laravel-error-pages",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ricardo Gobbo de Souza",
            "email": "ricardogobbosouza@yahoo.com.br"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "symfony/http-kernel": "^7.2|^8.0"
    },
    "require-dev": {
        "datalogix/tallkit": "^0.1.1",
        "larastan/larastan": "^3.14",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.8|^4.0|^5.0",
        "rector/rector": "^2.8"
    },
    "suggest": {
        "datalogix/tallkit": "Renders prettier error pages using the TALLKit UI components"
    },
    "autoload": {
        "psr-4": {
            "Datalogix\\ErrorPages\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Datalogix\\ErrorPages\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "lint": [
            "@php vendor/bin/pint --test --blade",
            "@php vendor/bin/phpstan analyse",
            "@php vendor/bin/rector --dry-run"
        ],
        "format": "@php vendor/bin/pint --blade"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Datalogix\\ErrorPages\\ErrorPagesServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
